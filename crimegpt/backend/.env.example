# Groq API key. Get one at https://console.groq.com
# NOTE: the free tier is 200,000 tokens/day (~25-40 analyses). A demo day with
# hands-on judges needs a paid tier or a spare key.
GROQ_API_KEY=

# Postgres + pgvector connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://crimegpt:crimegpt@localhost:5432/crimegpt

# Groq model + confidence threshold for the validation agent (0.0 - 1.0)
# llama-3.3-70b-versatile / llama-3.1-8b-instant are RETIRED (404), gemma2-9b-it
# decommissioned (400). gpt-oss-120b is the working model.
GROQ_MODEL=openai/gpt-oss-120b
CONFIDENCE_THRESHOLD=0.6

# Where generated .docx + s.63 certificates are written
ARTIFACT_DIR=./artifacts

# Indian Kanoon live case-law API token (optional). Leave empty to use the local
# judgments cache only. Register + get a token at https://api.indiankanoon.org/
INDIANKANOON_API_TOKEN=

# --- Fallback LLM provider (optional but recommended for demo day) ------------
# Groq's free tier is 200,000 tokens/day. When it runs out the pipeline degrades to
# the curated keyword mapping (no fact extraction). Set an NVIDIA NIM key from
# https://build.nvidia.com and the same call is retried there instead.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
